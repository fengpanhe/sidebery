{
  "manifest_version": 3,
  "name": "Sidebery — Chromium edition",
  "short_name": "Sidebery",
  "version": "0.1.0",
  "description": "An experimental Sidebery edition for Chromium: vertical tabs, colored groups, trees, and a mint sidebar.",
  "minimum_chrome_version": "116",
  "author": "Sidebery contributors; original project by mbnuqw",
  "homepage_url": "https://github.com/mbnuqw/sidebery",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["tabs", "tabGroups", "storage", "sidePanel"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Sidebery",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "open-sidebar": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open Sidebery in the current window"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
